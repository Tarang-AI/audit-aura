# ============================================
# LLM Configuration (Multi-Agent System)
# ============================================

# Google Gemini (Recommended for Multi-Agent System)
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_ENABLED=false

# OpenCode.ai Zen (Anthropic-Compatible)
ANTHROPIC_BASE_URL=https://opencode.ai/zen
ANTHROPIC_MODEL=minimax-m2.5-free
ANTHROPIC_API_KEY="opencodekey"
ENABLE_TOOL_SEARCH=true

# OpenCode.ai Zen (OpenAI-Compatible)
# Get your API key from: https://opencode.ai
OPENCODE_API_KEY=your_opencode_api_key_here
OPENCODE_MODEL=minimax-2.5-free
OPENCODE_ENABLED=false
OPENCODE_BASE_URL=https://api.opencode.ai/v1

# OpenAI (Alternative for PDF extraction and AI operations)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ENABLED=false

# Ollama Configuration (Local LLM fallback)
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=phi4-mini
OLLAMA_ENABLED=false

# LM Studio Configuration (Local LLM alternative)
# Use host.docker.internal to access host from Docker container
LM_STUDIO_HOST=http://host.docker.internal:1234
LM_STUDIO_MODEL=mistralai/mistral-7b-instruct-v0.3
LM_STUDIO_ENABLED=false

# Email Notifications (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password
SMTP_FROM=noreply@auditaura.com

# Slack Notifications (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# GitHub Integration (optional, for auto-remediation)
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO_OWNER=your_org
GITHUB_REPO_NAME=your_repo

# Application Configuration
LOG_LEVEL=INFO
MOCK_MODE=false
COMPLIANCE_CHECK_INTERVAL=30

# Encryption Key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=key
# Database (optional, for production)
DATABASE_URL=postgresql://user:password@localhost:5432/auditaura